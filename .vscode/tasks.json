{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build: Release Mode",
      "type": "shell",
      "command": "python3 build.py local",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Build: Debug Mode",
      "type": "shell",
      "command": "python3 build.py -e only_down_deps=true && mkdir -p build && cd build && cmake .. -DCMAKE_BUILD_TYPE=Debug -DSECUREC_LIB_DIR=${workspaceFolder}/prefix/securec_shared && make -j$(nproc)",
      "group": {
        "kind": "build"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Test: Run Unit Tests",
      "type": "shell",
      "command": "python3 build.py test local",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Clean: All Workspace",
      "type": "shell",
      "command": "rm -rf build prefix output artifacts test/build_llt test/output test/opensource opensource platform",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
